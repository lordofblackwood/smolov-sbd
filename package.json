  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.4",
    "serialize-javascript": "7.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.4"
